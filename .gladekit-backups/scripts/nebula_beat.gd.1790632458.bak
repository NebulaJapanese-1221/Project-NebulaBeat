extends Control

# First playable vertical slice for NebulaBeat.
# Incoming notes are spawned on an outer ring and accelerate as they approach
# the energy core. Mouse/touch-style drag segments slice targets in real time.

class Note extends RefCounted:
	var position: Vector2 = Vector2.ZERO
	var speed: float = 100.0
	var is_long: bool = false
	var hits_remaining: int = 1
	var last_sliced_stroke: int = -1
	var hue: float = 0.55
	var phase: float = 0.0


class SlashTrail extends RefCounted:
	var start: Vector2 = Vector2.ZERO
	var finish: Vector2 = Vector2.ZERO
	var life: float = 0.16


const CORE_RADIUS: float = 58.0
const NOTE_RADIUS: float = 25.0
const OUTER_MARGIN: float = 95.0
const MAX_CORE_HEALTH: int = 100
const LONG_NOTE_HITS: int = 3

var _notes: Array[Note] = []
var _slashes: Array[SlashTrail] = []
var _elapsed: float = 0.0
var _spawn_timer: float = 0.0
var _spawn_index: int = 0
var _score: int = 0
var _combo: int = 0
var _core_health: int = MAX_CORE_HEALTH
var _dragging: bool = false
var _active_touch_index: int = -1
var _last_drag_position: Vector2 = Vector2.ZERO
var _drag_stroke_id: int = 0
var _hit_flash: float = 0.0
var _game_over: bool = false


func _is_mobile_platform() -> bool:
	return OS.has_feature("mobile")


func _ready() -> void:
	set_anchors_and_offsets_preset(Control.PRESET_FULL_RECT)
	mouse_filter = Control.MOUSE_FILTER_STOP
	queue_redraw()


func _process(delta: float) -> void:
	if _game_over:
		_hit_flash = maxf(_hit_flash - delta, 0.0)
		queue_redraw()
		return

	_elapsed += delta
	_spawn_timer += delta
	var beat_interval: float = maxf(0.34, 0.78 - _elapsed * 0.007)
	if _spawn_timer >= beat_interval:
		_spawn_timer -= beat_interval
		_spawn_note()

	var core_position: Vector2 = _core_position()
	var start_distance: float = _spawn_radius()
	for index: int in range(_notes.size() - 1, -1, -1):
		var note: Note = _notes[index]
		var distance_to_core: float = note.position.distance_to(core_position)
		var proximity: float = clampf(1.0 - distance_to_core / start_distance, 0.0, 1.0)
		var travel_speed: float = note.speed * (1.0 + proximity * 1.9)
		note.position = note.position.move_toward(core_position, travel_speed * delta)
		note.phase += delta * (2.0 + proximity * 5.0)
		if note.position.distance_to(core_position) <= CORE_RADIUS + 8.0:
			_core_health = maxi(_core_health - (12 if note.is_long else 7), 0)
			_combo = 0
			_hit_flash = 0.36
			_notes.remove_at(index)
			if _core_health <= 0:
				_game_over = true

	for index: int in range(_slashes.size() - 1, -1, -1):
		var slash: SlashTrail = _slashes[index]
		slash.life -= delta
		if slash.life <= 0.0:
			_slashes.remove_at(index)

	_hit_flash = maxf(_hit_flash - delta, 0.0)
	queue_redraw()


func _input(event: InputEvent) -> void:
	if event.is_action_pressed(&"ui_cancel"):
		var pause_menu: Node = get_tree().get_first_node_in_group("pause_menu")
		if pause_menu != null and pause_menu.has_method("_set_paused"):
			pause_menu.call("_set_paused", not get_tree().paused)
			get_viewport().set_input_as_handled()
		return

	# Android can emit both touch and emulated mouse events for one gesture.
	# Native touch owns mobile slicing so each physical drag produces one stroke.
	if event is InputEventMouseButton and not _is_mobile_platform():
		var mouse_button: InputEventMouseButton = event
		if mouse_button.button_index != MOUSE_BUTTON_LEFT:
			return
		if mouse_button.pressed:
			if _game_over:
				_restart()
				return
			_dragging = true
			_drag_stroke_id += 1
			_last_drag_position = mouse_button.position
		else:
			_dragging = false
	elif event is InputEventMouseMotion and _dragging and not _game_over and not _is_mobile_platform():
		var mouse_motion: InputEventMouseMotion = event
		if mouse_motion.position.distance_to(_last_drag_position) >= 4.0:
			_slice_between(_last_drag_position, mouse_motion.position)
			_last_drag_position = mouse_motion.position
	elif event is InputEventScreenTouch:
		var screen_touch: InputEventScreenTouch = event
		if screen_touch.pressed:
			if _dragging:
				return
			if _game_over:
				_restart()
				return
			_dragging = true
			_active_touch_index = screen_touch.index
			_drag_stroke_id += 1
			_last_drag_position = screen_touch.position
		elif screen_touch.index == _active_touch_index:
			_dragging = false
			_active_touch_index = -1
	elif event is InputEventScreenDrag and _dragging and not _game_over:
		var screen_drag: InputEventScreenDrag = event
		if screen_drag.index != _active_touch_index:
			return
		if screen_drag.position.distance_to(_last_drag_position) >= 4.0:
			_slice_between(_last_drag_position, screen_drag.position)
			_last_drag_position = screen_drag.position


func _spawn_note() -> void:
	var note: Note = Note.new()
	var angle: float = fmod(float(_spawn_index) * 2.399963 + _elapsed * 0.23, TAU)
	var core_position: Vector2 = _core_position()
	note.position = core_position + Vector2(cos(angle), sin(angle)) * _spawn_radius()
	note.speed = 98.0 + minf(_elapsed * 3.8, 100.0)
	note.is_long = _spawn_index > 0 and _spawn_index % 5 == 0
	note.hits_remaining = LONG_NOTE_HITS if note.is_long else 1
	note.hue = fmod(0.52 + float(_spawn_index % 4) * 0.095, 1.0)
	_notes.append(note)
	_spawn_index += 1


func _slice_between(start: Vector2, finish: Vector2) -> void:
	var trail: SlashTrail = SlashTrail.new()
	trail.start = start
	trail.finish = finish
	_slashes.append(trail)

	for index: int in range(_notes.size() - 1, -1, -1):
		var note: Note = _notes[index]
		var hit_radius: float = NOTE_RADIUS + (22.0 if note.is_long else 7.0)
		if _distance_to_segment(note.position, start, finish) > hit_radius:
			continue
		if note.is_long and note.last_sliced_stroke == _drag_stroke_id:
			continue
		if note.is_long:
			note.last_sliced_stroke = _drag_stroke_id
		note.hits_remaining -= 1
		_hit_flash = 0.09
		if note.hits_remaining <= 0:
			_score += 125 + _combo * 10
			_combo += 1
			_notes.remove_at(index)
		else:
			_score += 35
			_combo += 1


func _distance_to_segment(point: Vector2, start: Vector2, finish: Vector2) -> float:
	var segment: Vector2 = finish - start
	var length_squared: float = segment.length_squared()
	if length_squared <= 0.001:
		return point.distance_to(start)
	var interpolation: float = clampf((point - start).dot(segment) / length_squared, 0.0, 1.0)
	return point.distance_to(start + segment * interpolation)


func _restart() -> void:
	_notes.clear()
	_slashes.clear()
	_elapsed = 0.0
	_spawn_timer = 0.0
	_spawn_index = 0
	_score = 0
	_combo = 0
	_core_health = MAX_CORE_HEALTH
	_game_over = false
	_hit_flash = 0.0


func _core_position() -> Vector2:
	return size * 0.5


func _spawn_radius() -> float:
	return maxf(size.x, size.y) * 0.58 + OUTER_MARGIN


func _draw() -> void:
	var viewport_size: Vector2 = size
	var center: Vector2 = _core_position()
	var arena_radius: float = minf(viewport_size.x, viewport_size.y) * 0.45
	var background_color: Color = Color("091225")
	draw_rect(Rect2(Vector2.ZERO, viewport_size), background_color)

	# Subtle concentric timing rings make the approach windows readable.
	for ring_index: int in range(4, 0, -1):
		var ring_radius: float = arena_radius * float(ring_index) / 4.0
		var ring_color: Color = Color(0.13, 0.45, 0.72, 0.05 + float(ring_index) * 0.018)
		draw_arc(center, ring_radius, 0.0, TAU, 96, ring_color, 1.5, true)

	# Aim lines create an uncluttered beat-grid feeling without obscuring notes.
	for spoke_index: int in range(8):
		var angle: float = TAU * float(spoke_index) / 8.0 + _elapsed * 0.05
		var endpoint: Vector2 = center + Vector2(cos(angle), sin(angle)) * arena_radius
		draw_line(center, endpoint, Color(0.18, 0.5, 0.78, 0.10), 1.0, true)

	_draw_notes(center)
	_draw_core(center)
	_draw_slashes()
	_draw_hud(viewport_size)


func _draw_notes(center: Vector2) -> void:
	for note: Note in _notes:
		var approach_direction: Vector2 = (center - note.position).normalized()
		var side_direction: Vector2 = Vector2(-approach_direction.y, approach_direction.x)
		var pulse: float = 1.0 + sin(note.phase * 5.0) * 0.08
		var note_color: Color = Color.from_hsv(note.hue, 0.72, 1.0)
		var outline_color: Color = Color.from_hsv(note.hue, 0.35, 1.0, 0.35)
		if note.is_long:
			var half_length: float = 58.0
			var half_width: float = 15.0
			var long_points: PackedVector2Array = PackedVector2Array([
				note.position - side_direction * half_length - approach_direction * half_width,
				note.position + side_direction * half_length - approach_direction * half_width,
				note.position + side_direction * half_length + approach_direction * half_width,
				note.position - side_direction * half_length + approach_direction * half_width
			])
			draw_colored_polygon(long_points, Color(note_color, 0.78))
			draw_polyline(long_points + PackedVector2Array([long_points[0]]), outline_color, 3.0, true)
			var segments: int = LONG_NOTE_HITS
			for segment_index: int in range(segments):
				var marker_t: float = (float(segment_index) + 0.5) / float(segments) - 0.5
				var marker: Vector2 = note.position + side_direction * marker_t * half_length * 2.0
				var marker_color: Color = Color.WHITE if segment_index < note.hits_remaining else Color(note_color, 0.22)
				draw_circle(marker, 4.0, marker_color)
		else:
			var radius: float = NOTE_RADIUS * pulse
			var diamond: PackedVector2Array = PackedVector2Array([
				note.position + Vector2(0.0, -radius),
				note.position + Vector2(radius, 0.0),
				note.position + Vector2(0.0, radius),
				note.position + Vector2(-radius, 0.0)
			])
			draw_colored_polygon(diamond, note_color)
			draw_polyline(diamond + PackedVector2Array([diamond[0]]), Color.WHITE, 2.0, true)
			draw_circle(note.position, 5.0, Color(0.03, 0.08, 0.16, 0.78))


func _draw_core(center: Vector2) -> void:
	var damage_ratio: float = 1.0 - float(_core_health) / float(MAX_CORE_HEALTH)
	var glow_color: Color = Color(0.12 + damage_ratio * 0.75, 0.78 - damage_ratio * 0.42, 1.0, 0.14 + _hit_flash * 0.7)
	draw_circle(center, CORE_RADIUS + 27.0 + sin(_elapsed * 3.0) * 3.0, glow_color)
	draw_circle(center, CORE_RADIUS + 8.0, Color(0.06, 0.17, 0.34, 0.95))
	draw_arc(center, CORE_RADIUS + 8.0, _elapsed * 1.9, _elapsed * 1.9 + TAU * 0.72, 48, Color(0.2, 0.92, 1.0), 4.0, true)
	draw_arc(center, CORE_RADIUS + 8.0, -_elapsed * 2.5, -_elapsed * 2.5 + TAU * 0.34, 48, Color(0.83, 0.3, 1.0), 4.0, true)
	draw_circle(center, CORE_RADIUS, Color(0.1 + _hit_flash * 0.9, 0.67, 0.96, 0.96))
	draw_circle(center, CORE_RADIUS * 0.52, Color(0.85, 0.98, 1.0, 0.95))
	var shard_angle: float = _elapsed * 2.8
	for shard_index: int in range(3):
		var angle: float = shard_angle + TAU * float(shard_index) / 3.0
		var shard_position: Vector2 = center + Vector2(cos(angle), sin(angle)) * 25.0
		draw_circle(shard_position, 7.0, Color(0.2, 0.82, 1.0))


func _draw_slashes() -> void:
	for slash: SlashTrail in _slashes:
		var alpha: float = clampf(slash.life / 0.16, 0.0, 1.0)
		draw_line(slash.start, slash.finish, Color(0.88, 0.98, 1.0, alpha), 7.0 * alpha + 1.0, true)


func _draw_hud(viewport_size: Vector2) -> void:
	var font: Font = ThemeDB.fallback_font
	var health_ratio: float = float(_core_health) / float(MAX_CORE_HEALTH)
	draw_string(font, Vector2(32.0, 44.0), "NEBULA BEAT", HORIZONTAL_ALIGNMENT_LEFT, -1.0, 26, Color(0.63, 0.9, 1.0))
	draw_string(font, Vector2(32.0, 74.0), "SCORE  %06d" % _score, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 19, Color(0.91, 0.96, 1.0))
	if _combo > 1:
		draw_string(font, Vector2(32.0, 102.0), "%d COMBO" % _combo, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 19, Color(1.0, 0.56, 0.94))

	var health_rect: Rect2 = Rect2(viewport_size.x - 252.0, 30.0, 220.0, 16.0)
	draw_string(font, Vector2(health_rect.position.x, 24.0), "CORE INTEGRITY", HORIZONTAL_ALIGNMENT_LEFT, -1.0, 16, Color(0.7, 0.84, 0.98))
	draw_rect(health_rect, Color(0.05, 0.08, 0.16, 0.9))
	draw_rect(Rect2(health_rect.position, Vector2(health_rect.size.x * health_ratio, health_rect.size.y)), Color(0.18 + (1.0 - health_ratio) * 0.72, 0.92 * health_ratio, 1.0, 0.95))
	draw_rect(health_rect, Color(0.48, 0.78, 1.0, 0.8), false, 1.0)

	if _elapsed < 5.5 and not _game_over:
		var action_label: String = "SWIPE" if _is_mobile_platform() else "DRAG"
		var prompt: String = "%s THROUGH NOTES  •  LONG NOTES NEED %d SLICES" % [action_label, LONG_NOTE_HITS]
		var prompt_width: float = font.get_string_size(prompt, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 17).x
		draw_string(font, Vector2((viewport_size.x - prompt_width) * 0.5, viewport_size.y - 32.0), prompt, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 17, Color(0.68, 0.84, 1.0, 0.88))

	if _game_over:
		draw_rect(Rect2(Vector2.ZERO, viewport_size), Color(0.02, 0.03, 0.10, 0.73))
		var game_over_text: String = "CORE LOST"
		var restart_text: String = "CLICK TO RESTART  •  SCORE %06d" % _score
		var game_over_width: float = font.get_string_size(game_over_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 42).x
		var restart_width: float = font.get_string_size(restart_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 18).x
		draw_string(font, Vector2((viewport_size.x - game_over_width) * 0.5, viewport_size.y * 0.5 - 10.0), game_over_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 42, Color(1.0, 0.37, 0.63))
		draw_string(font, Vector2((viewport_size.x - restart_width) * 0.5, viewport_size.y * 0.5 + 28.0), restart_text, HORIZONTAL_ALIGNMENT_LEFT, -1.0, 18, Color(0.83, 0.94, 1.0))
