extends RefCounted
class_name LevelState

# Session-level selection shared by the level selector, editor, and gameplay scene.
const BUILT_IN_LEVELS: Array[Dictionary] = [
	{"id": 1, "title": "Tutorial 01 — First Slice", "subtitle": "Learn the drag-slice rhythm.", "spawn_interval": 0.92, "speed_multiplier": 0.72, "long_every": 0, "target_notes": 12, "tutorial": true},
	{"id": 2, "title": "Tutorial 02 — Core Guard", "subtitle": "Protect the core as the tempo rises.", "spawn_interval": 0.78, "speed_multiplier": 0.82, "long_every": 0, "target_notes": 16, "tutorial": true},
	{"id": 3, "title": "Tutorial 03 — Long Notes", "subtitle": "Chain repeated cuts through long notes.", "spawn_interval": 0.74, "speed_multiplier": 0.88, "long_every": 4, "target_notes": 18, "tutorial": true},
	{"id": 4, "title": "Phase Shift", "subtitle": "A steady barrage with wider slicing lanes.", "spawn_interval": 0.67, "speed_multiplier": 1.00, "long_every": 5, "target_notes": 22, "tutorial": false},
	{"id": 5, "title": "Ion Rush", "subtitle": "Fast notes converge on the core.", "spawn_interval": 0.59, "speed_multiplier": 1.14, "long_every": 4, "target_notes": 26, "tutorial": false},
	{"id": 6, "title": "Supernova", "subtitle": "Dense long-note patterns under pressure.", "spawn_interval": 0.51, "speed_multiplier": 1.28, "long_every": 3, "target_notes": 30, "tutorial": false},
	{"id": 7, "title": "Nebula Breaker", "subtitle": "The final high-speed endurance chart.", "spawn_interval": 0.44, "speed_multiplier": 1.42, "long_every": 3, "target_notes": 36, "tutorial": false}
]

static var selected_level_id: int = 1
static var selected_level_title: String = "Tutorial 01 — First Slice"
static var custom_note_pattern: Array[bool] = []
static var custom_spawn_interval: float = 0.68
static var custom_speed_multiplier: float = 1.0


static func select_builtin(level_id: int) -> void:
	selected_level_id = clampi(level_id, 1, BUILT_IN_LEVELS.size())
	var level: Dictionary = BUILT_IN_LEVELS[selected_level_id - 1]
	selected_level_title = String(level["title"])


static func select_custom() -> void:
	selected_level_id = 0
	selected_level_title = "Custom Chart"


static func get_level_data() -> Dictionary:
	if selected_level_id == 0:
		var active_notes: int = maxi(custom_note_pattern.count(true), 1)
		return {
			"id": 0,
			"title": selected_level_title,
			"subtitle": "Custom editor chart",
			"spawn_interval": custom_spawn_interval,
			"speed_multiplier": custom_speed_multiplier,
			"long_every": 0,
			"target_notes": active_notes,
			"tutorial": false
		}
	return BUILT_IN_LEVELS[clampi(selected_level_id, 1, BUILT_IN_LEVELS.size()) - 1].duplicate()


static func is_custom_long_note(note_index: int) -> bool:
	if selected_level_id != 0 or custom_note_pattern.is_empty():
		return false
	return custom_note_pattern[note_index % custom_note_pattern.size()]


static func reset_custom_chart() -> void:
	custom_note_pattern.clear()
	custom_spawn_interval = 0.68
	custom_speed_multiplier = 1.0


static func is_level_unlocked(level_id: int) -> bool:
	if level_id <= 1:
		return true
	return int(SaveManager.get_value("nebula_unlocked_level", 1)) >= level_id


static func best_score(level_id: int) -> int:
	return int(SaveManager.get_value("nebula_best_score_%d" % level_id, 0))


static func best_stars(level_id: int) -> int:
	return int(SaveManager.get_value("nebula_best_stars_%d" % level_id, 0))


static func record_completion(level_id: int, score: int, stars: int) -> void:
	if level_id <= 0:
		return
	var score_key: String = "nebula_best_score_%d" % level_id
	var stars_key: String = "nebula_best_stars_%d" % level_id
	SaveManager.set_value(score_key, maxi(best_score(level_id), score))
	SaveManager.set_value(stars_key, maxi(best_stars(level_id), stars))
	var unlocked_level: int = int(SaveManager.get_value("nebula_unlocked_level", 1))
	SaveManager.set_value("nebula_unlocked_level", maxi(unlocked_level, mini(level_id + 1, BUILT_IN_LEVELS.size())))
	SaveManager.save()
